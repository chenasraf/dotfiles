#!/usr/bin/env bash
# Notify when a Claude Code turn finishes, but only if it ran long enough to be
# worth hearing about.
#
# Called from two hooks, which both receive the hook JSON on stdin:
#
#   UserPromptSubmit -> claude-turn-notify start
#   Stop             -> claude-turn-notify stop
#
# The guard is the whole point. `Stop` fires on every stop — including /clear,
# resume and compact — so a hook that notifies unconditionally is one
# notification per turn, which is how a channel gets muted and stops being read.
# `notify.zsh` solves the same problem for shell commands with NOTIFY_AFTER;
# this is that idea, with the start time carried between two hook invocations
# because a hook cannot keep state in memory.
#
# A stop with no recorded start sends nothing, which is what makes /clear,
# compaction and a resumed session quiet without having to detect them.
set -euo pipefail

PATH=/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin
export PATH

# Seconds a turn must run before finishing is worth a notification. It can be
# this low because `watching` below suppresses the case the threshold used to
# guard against — a ping arriving while you sit there looking at the turn
# finish. What is left for the threshold is not bothering to notify about a
# turn that was quick even though you stepped away.
THRESHOLD=${CLAUDE_TURN_NOTIFY_AFTER:-60}
STATE_DIR="${TMPDIR:-/tmp}/claude-turn-notify-$(id -u)"
AGENT="${DOTFILES:-$HOME/.dotfiles}/.local/bin/ntfy-agent"

usage() { printf 'usage: claude-turn-notify start|stop   (hook JSON on stdin)\n' >&2; }

MODE=${1:-}

PAYLOAD=''
if [ ! -t 0 ]; then
    PAYLOAD=$(cat)
fi

# Keyed per session so two sessions running at once cannot time each other's
# turns. A payload without session_id degrades to one shared key rather than
# failing: wrong only if two sessions overlap, and still better than silence.
SESSION=$(printf '%s' "$PAYLOAD" | jq -r '.session_id // empty' 2>/dev/null || true)
[ -n "$SESSION" ] || SESSION=default
SESSION=$(printf '%s' "$SESSION" | tr -c 'A-Za-z0-9._-' '_')
STAMP="$STATE_DIR/$SESSION"

# Whether you are looking at this terminal right now: it is the frontmost app
# and, inside tmux, this is the active pane of an attached session's active
# window. Ported from _notify_watching in notify.zsh, which already tuned this
# for the same purpose, and deliberately keeping its fail-open direction — over
# SSH or off macOS there is no telling, so it reports not watching and the
# notification goes out. A notifier that guesses wrong should err towards
# sending, not towards silence.
watching() {
    [ "${CLAUDE_TURN_NOTIFY_ALWAYS:-}" = 1 ] && return 1
    [ -n "${SSH_CONNECTION:-}" ] && return 1
    command -v lsappinfo >/dev/null 2>&1 || return 1

    local front
    front=$(lsappinfo info -only bundleid "$(lsappinfo front)" 2>/dev/null) || return 1
    case "$front" in
        *"bundleID=\"${NOTIFY_TERMINAL_BUNDLE:-com.mitchellh.ghostty}\""*) ;;
        *) return 1 ;;
    esac

    if [ -n "${TMUX:-}" ]; then
        local visible
        visible=$(tmux display-message -p -t "${TMUX_PANE:-}" \
            '#{&&:#{window_active},#{pane_active}}#{?session_attached,1,0}' 2>/dev/null) || return 1
        [ "$visible" = 11 ] || return 1
    fi
}

human() {
    if [ "$1" -ge 3600 ]; then printf '%dh %dm' "$(( $1 / 3600 ))" "$(( $1 % 3600 / 60 ))"
    elif [ "$1" -ge 60 ]; then printf '%dm %ds' "$(( $1 / 60 ))" "$(( $1 % 60 ))"
    else printf '%ds' "$1"
    fi
}

case "$MODE" in
    start)
        mkdir -p "$STATE_DIR"
        date +%s > "$STAMP"
        # Sessions that ended without a Stop would otherwise accumulate here.
        find "$STATE_DIR" -type f -mtime +1 -delete 2>/dev/null || true
        ;;
    stop)
        [ -r "$STAMP" ] || exit 0
        STARTED=''
        read -r STARTED 2>/dev/null < "$STAMP" || STARTED=''
        rm -f "$STAMP"
        case "$STARTED" in ''|*[!0-9]*) exit 0 ;; esac

        ELAPSED=$(( $(date +%s) - STARTED ))
        [ "$ELAPSED" -ge "$THRESHOLD" ] || exit 0

        # Checked after the threshold because it is the expensive one: it shells
        # out to lsappinfo and possibly tmux, where the threshold is arithmetic.
        if watching; then exit 0; fi

        # The directory, because the useful question on a phone is which project
        # wants attention, not which session id.
        WHERE=$(basename "$(pwd)")
        "$AGENT" -T "finished after $(human "$ELAPSED")" \
            "Claude finished a turn in $WHERE." || true
        ;;
    *)
        usage
        exit 1
        ;;
esac
