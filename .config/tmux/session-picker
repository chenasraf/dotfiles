#!/usr/bin/env python3

# Session/window picker for a tmux popup.
#
#   session-picker popup <kind> <c>  open the `sessions` or `claude` picker in a popup on client <c>,
#                                    sized by $TMUX_SWITCHER_SIZE: 0 (default) is borderless full
#                                    screen, 1-100 a bordered popup at that percentage
#   session-picker digit <d> <kind>  fzf actions for a 0-9 key: pick the row numbered <d>
#   session-picker kill <kind> <id>  fzf actions for d: arm a kill of row <id>, or confirm it
#   session-picker disarm <t>        once arming <t> times out, restore the key legend
#   session-picker legend <kind> <state> <pid>
#                                    draw the key legend in a pane under the picker <pid>
#
#   session-picker <client>          fzf list of sessions and windows; Enter switches <client>
#   session-picker preview <target>  draw <target>'s window: real pane layout + pane contents
#   session-picker list [query]      rows for fzf's reload: the expanded tree, or the matches for query
#   session-picker key <k> <id> <q>  fzf actions for right/left and l/h (expand/collapse), esc, and new
#                                    results
#
#   session-picker claude <client>   fzf list of Claude Code panes; i works in one, Enter switches
#   session-picker claude-list       rows for that list's reload
#   session-picker peek <pane>       attach a nested client to <pane> inside the popup
#   session-picker after-peek        fzf actions once that client detaches (quit or refresh)
#
# The preview never switches the client — it reads geometry with list-panes and contents with
# capture-pane, then scales everything into the fzf preview area.

import contextlib
import json
import os
import re
import select
import signal
import subprocess
import sys
import tempfile
import time
import unicodedata

SELF = os.path.abspath(__file__)

U, R, D, L = 1, 2, 4, 8
BOX = {
    R | L: "─",
    U | D: "│",
    R | D: "╭",
    L | D: "╮",
    U | R: "╰",
    U | L: "╯",
    U | R | D: "├",
    U | L | D: "┤",
    L | R | D: "┬",
    U | L | R: "┴",
    U | R | D | L: "┼",
    R: "─",
    L: "─",
    U: "│",
    D: "│",
}

SGR = re.compile(r"\x1b\[([0-9;:]*)m")
OTHER_ESC = re.compile(
    r"\x1b(\[[0-9;:?<>=]*[@-~]|\][^\x07\x1b]*(\x07|\x1b\\)|[()][0-9A-Za-z]|[=>])"
)
ANY_ESC = re.compile(f"{SGR.pattern}|{OTHER_ESC.pattern}")


def tmux(*args):
    return subprocess.run(["tmux", *args], capture_output=True, text=True).stdout


def rows(*args):
    return [line.split("\t") for line in tmux(*args).splitlines() if line]


def client_session(client):
    # display -c only scopes client formats; #{session_id} there is still the caller's session
    return next(
        (s for c, s in rows("list-clients", "-F", "#{client_name}\t#{session_id}") if c == client),
        "",
    )


def fg(hex_color, bold=False):
    if not hex_color.startswith("#") or len(hex_color) != 7:
        return "\x1b[1m" if bold else ""
    r, g, b = (int(hex_color[i : i + 2], 16) for i in (1, 3, 5))
    return f"\x1b[{'1;' if bold else ''}38;2;{r};{g};{b}m"


# Legend rows: getting around on the first, everything else on the second
SESSION_KEYS = [
    [
        ("↑↓/jk", "move"),
        ("→←/lh", "expand/collapse"),
        ("enter", "switch"),
        ("0-9", "switch to session"),
    ],
    [
        ("/", "search"),
        ("esc", "leave search"),
        ("dd", "kill"),
        ("q", "quit"),
    ],
]
CLAUDE_KEYS = [
    [
        ("↑↓/jk", "move"),
        ("enter", "switch"),
        ("0-9", "switch to pane"),
        ("i", "interact"),
        ("^c", "back to list"),
        ("^d", "close"),
    ],
    [
        ("/", "search"),
        ("esc", "leave search"),
        ("dd", "kill"),
        ("q", "quit"),
    ],
]
KEYS = {"session": SESSION_KEYS, "claude": CLAUDE_KEYS}


# The key legend lives in its own tmux pane under fzf rather than in fzf: fzf's footer only spans
# the list column, and its border label, which does span the popup, is a single line. The pane runs
# `session-picker legend`, which redraws on SIGUSR1 (state changed) and SIGWINCH, and sizes its
# pane to the lines the legend wraps to.
@contextlib.contextmanager
def legend(kind):
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        yield
        return
    t = theme()
    border = f"fg={t['overlay_0']}" if t["overlay_0"] else "dim"
    legend_id, legend_pid = (
        tmux(
            "split-window",
            "-d",
            "-v",
            "-l",
            "2",
            "-t",
            pane,
            "-P",
            "-F",
            "#{pane_id}\t#{pane_pid}",
            SELF,
            "legend",
            kind,
            os.environ["SESSION_PICKER_STATE"],
            str(os.getpid()),
        )
        .strip()
        .split("\t")
    )
    # the theme gives every pane a bottom status line and the active one a filled border
    for opt, value in (
        ("pane-border-status", "off"),
        ("pane-border-style", border),
        ("pane-active-border-style", border),
    ):
        tmux("set", "-w", "-t", pane, opt, value)
    os.environ["SESSION_PICKER_LEGEND"] = legend_pid
    try:
        yield
    finally:
        # the popup only closes once its session ends, and this pane would keep it alive
        tmux("kill-pane", "-t", legend_id)


def redraw_legend():
    with contextlib.suppress(KeyError, ValueError, ProcessLookupError):
        os.kill(int(os.environ["SESSION_PICKER_LEGEND"]), signal.SIGUSR1)


def legend_lines(kind, width, state):
    t = theme()
    reset = "\x1b[0m"
    armed = state.get("armed")
    if armed:
        return [
            f"  {fg(t['red'], bold=True)}d{reset} {fg(t['text'])}again to kill{reset}"
            f" {fg(t['peach'], bold=True)}{armed['what']}{reset}"
        ]
    rows_ = KEYS[kind]
    gap, margin = 4, 2

    def entry(k, d, pad=0):
        return f"{fg(t['sky'])}{k}{reset} {fg(t['overlay_1'])}{d}{reset}" + " " * pad

    def size(k, d):
        return len(k) + 1 + len(d)

    # entries line up in columns, as long as the widest row fits
    cols = [
        max(size(*row[i]) for row in rows_ if i < len(row))
        for i in range(max(map(len, rows_)))
    ]
    if margin + sum(cols) + gap * (len(cols) - 1) <= width:
        return [
            " " * margin
            + (" " * gap).join(
                entry(k, d, cols[i] - size(k, d) if i < len(row) - 1 else 0)
                for i, (k, d) in enumerate(row)
            )
            for row in rows_
        ]

    # too narrow: each row wraps on its own
    lines = []
    for row in rows_:
        line, used = [], margin
        for k, d in row:
            w = size(k, d) + (gap if line else 0)
            if line and used + w > width:
                lines.append(line)
                line, used, w = [], margin, size(k, d)
            line.append(entry(k, d))
            used += w
        lines.append(line)
    return [" " * margin + (" " * gap).join(line) for line in lines]


def legend_pane(kind, state_path, owner):
    os.environ["SESSION_PICKER_STATE"] = state_path
    wake_r, wake_w = os.pipe()
    os.set_blocking(wake_w, False)
    signal.set_wakeup_fd(wake_w)
    for sig in (signal.SIGUSR1, signal.SIGWINCH):
        signal.signal(sig, lambda *_: None)
    # no cursor, and no autowrap: an overlong line is cut rather than spilling onto the next
    sys.stdout.write("\x1b[?25l\x1b[?7l")
    height = None
    while True:
        try:
            state = load_state()
        except (OSError, ValueError):
            state = {}
        cols, rows_ = os.get_terminal_size()
        lines = legend_lines(kind, cols, state)
        # an armed prompt is shorter, but the list shouldn't jump while it shows
        if not state.get("armed"):
            height = len(lines)
        if height and rows_ != height:
            tmux("resize-pane", "-t", os.environ["TMUX_PANE"], "-y", str(height))
        sys.stdout.write("\x1b[H\x1b[2J" + "\r\n".join(lines))
        sys.stdout.flush()
        # wake on a signal, or each second to notice the picker is gone if it died without
        # killing this pane
        while not select.select([wake_r], [], [], 1)[0]:
            try:
                os.kill(owner, 0)
            except ProcessLookupError:
                return
        os.read(wake_r, 1024)


def theme():
    names = [
        "sky",
        "overlay_0",
        "overlay_1",
        "blue",
        "green",
        "subtext_0",
        "text",
        "peach",
        "red",
    ]
    values = (
        tmux("display", "-p", "\t".join(f"#{{@thm_{n}}}" for n in names))
        .rstrip("\n")
        .split("\t")
    )
    return dict(zip(names, values + [""] * len(names)))


def char_width(ch):
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def parse_cells(lines):
    """Turn capture-pane -e output into rows of (char, style) cells.

    capture-pane carries SGR state across lines, so style must too.
    """
    style = ""
    out = []
    for line in lines:
        cells = []
        pos = 0
        for m in ANY_ESC.finditer(line + "\x1b[m"):
            for ch in line[pos : m.start()].replace("\t", " "):
                w = char_width(ch)
                if w == 0:
                    if cells and cells[-1][0]:
                        cells[-1] = (cells[-1][0] + ch, cells[-1][1])
                    continue
                cells.append((ch, style))
                if w == 2:
                    cells.append((None, style))
            pos = m.end()
            if m.start() >= len(line):
                break
            params = m.group(1)
            if params is not None:
                style = "" if params in ("", "0") else style + m.group(0)
        out.append(cells)
    return out


def is_blank(cells):
    return all(c is None or c.isspace() for c, _ in cells)


class Canvas:
    def __init__(self, width, height):
        self.w, self.h = width, height
        self.cells = [[(" ", "") for _ in range(width)] for _ in range(height)]

    def put(self, x, y, ch, style=""):
        if 0 <= x < self.w and 0 <= y < self.h:
            self.cells[y][x] = (ch, style)

    def text(self, x, y, s, style="", limit=None):
        for i, ch in enumerate(s[: limit if limit is not None else len(s)]):
            self.put(x + i, y, ch, style)

    def render(self):
        out = []
        for row in self.cells:
            line, cur = [], None
            for i, (ch, style) in enumerate(row):
                if ch is None:
                    continue
                # a wide char whose right half got overwritten (e.g. by a border) would push the line
                if (
                    i + 1 < len(row)
                    and row[i + 1][0] is not None
                    and char_width(ch[0]) == 2
                ):
                    ch = " "
                if style != cur:
                    line.append("\x1b[0m" + style)
                    cur = style
                line.append(ch)
            out.append("".join(line) + "\x1b[0m")
        return "\n".join(out)


def draw_contents(canvas, p, x0, y0, x1, y1, from_bottom=None):
    """Fill the inside of box (x0, y0)-(x1, y1) with pane p's captured contents."""
    iw, ih = x1 - x0 - 1, y1 - y0 - 1
    if iw <= 0 or ih <= 0:
        return
    cells = parse_cells(
        tmux("capture-pane", "-p", "-e", "-t", p["id"]).split("\n")[: p["height"]]
    )
    if from_bottom is None:
        # full-screen apps (editors, TUIs) read best from the top; shells from the most recent
        # output, just above the prompt
        from_bottom = not p["alternate"]
    if from_bottom:
        while cells and is_blank(cells[-1]):
            cells.pop()
        shown = cells[-ih:]
    else:
        shown = cells[:ih]
    for dy, row in enumerate(shown):
        for dx, cell in enumerate(row[:iw]):
            ch, style = cell
            if ch is not None and dx == iw - 1 and char_width(ch[0]) == 2:
                ch = " "
            canvas.cells[y0 + 1 + dy][x0 + 1 + dx] = (ch, style)
        for dx in range(len(row[:iw]), iw):
            canvas.cells[y0 + 1 + dy][x0 + 1 + dx] = (" ", "")


def draw_box(canvas, x0, y0, x1, y1, style):
    for x in range(x0 + 1, x1):
        canvas.put(x, y0, "─", style)
        canvas.put(x, y1, "─", style)
    for y in range(y0 + 1, y1):
        canvas.put(x0, y, "│", style)
        canvas.put(x1, y, "│", style)
    for x, y, ch in ((x0, y0, "╭"), (x1, y0, "╮"), (x0, y1, "╰"), (x1, y1, "╯")):
        canvas.put(x, y, ch, style)


def preview_pane(pane):
    """A single pane, bottom-anchored, under a header naming where it lives."""
    cols = int(os.environ.get("FZF_PREVIEW_COLUMNS", "80"))
    lines = int(os.environ.get("FZF_PREVIEW_LINES", "24"))
    t = theme()
    session, idx, window, path, height = (
        tmux(
            "display",
            "-p",
            "-t",
            pane,
            "#{session_name}\t#{window_index}\t#{window_name}\t#{pane_current_path}"
            "\t#{pane_height}",
        )
        .rstrip("\n")
        .split("\t")
    )
    home = os.path.expanduser("~")
    if path == home or path.startswith(home + "/"):
        path = "~" + path[len(home) :]

    canvas = Canvas(cols, lines)
    canvas.text(0, 0, f" {session}", fg(t["blue"], bold=True))
    canvas.text(len(session) + 2, 0, f"{idx} {window}", fg(t["overlay_1"]))
    canvas.text(len(session) + len(idx) + len(window) + 4, 0, path, fg(t["overlay_0"]))
    draw_box(canvas, 0, 1, cols - 1, lines - 1, fg(t["sky"]))
    # agent TUIs keep their prompt and latest output at the bottom
    p = dict(id=pane, height=int(height), alternate=True)
    draw_contents(canvas, p, 0, 1, cols - 1, lines - 1, from_bottom=True)
    print(canvas.render())


def preview(target):
    if target.startswith("%"):
        preview_pane(target)
        return

    cols = int(os.environ.get("FZF_PREVIEW_COLUMNS", "80"))
    lines = int(os.environ.get("FZF_PREVIEW_LINES", "24"))
    t = theme()

    info = tmux(
        "display",
        "-p",
        "-t",
        target,
        "#{session_id}\t#{window_id}\t#{window_width}\t#{window_height}\t#{window_zoomed_flag}",
    )
    sid, wid, ww, wh, zoomed = info.rstrip("\n").split("\t")
    ww, wh = int(ww), int(wh)

    canvas = Canvas(cols, lines)

    # header: the session's windows, previewed one highlighted
    x = 0
    for _, w_id, idx, name in rows(
        "list-windows",
        "-t",
        sid,
        "-F",
        "#{session_id}\t#{window_id}\t#{window_index}\t#{window_name}",
    ):
        label = f" {idx} {name} "
        style = fg(t["sky"], bold=True) if w_id == wid else fg(t["overlay_1"])
        canvas.text(x, 0, label, style)
        x += len(label) + 1

    panes = rows(
        "list-panes",
        "-t",
        wid,
        "-F",
        "#{pane_id}\t#{pane_index}\t#{pane_left}\t#{pane_top}\t#{pane_width}\t#{pane_height}"
        "\t#{pane_active}\t#{pane_floating_flag}\t#{alternate_on}\t#{pane_current_command}",
    )
    panes = [
        dict(
            id=p[0],
            index=p[1],
            left=int(p[2]),
            top=int(p[3]),
            width=int(p[4]),
            height=int(p[5]),
            active=p[6] == "1",
            floating=p[7] == "1",
            alternate=p[8] == "1",
            command=p[9],
        )
        for p in panes
    ]
    if zoomed == "1":
        # geometry of hidden panes is stale while zoomed, so show only what is actually visible
        panes = [
            dict(p, left=0, top=0, width=ww, height=wh) for p in panes if p["active"]
        ]

    # layout area sits below the header; window cell (x, y) has its borders at x and x+width+1
    top, area_w, area_h = 1, cols, lines - 1
    sx = (area_w - 1) / (ww + 1)
    sy = (area_h - 1) / (wh + 1)

    def box(p):
        return (
            round(p["left"] * sx),
            top + round(p["top"] * sy),
            round((p["left"] + p["width"] + 1) * sx),
            top + round((p["top"] + p["height"] + 1) * sy),
        )

    border = fg(t["overlay_0"])
    active_border = fg(t["sky"])

    def perimeter(x0, y0, x1, y1):
        for x in range(x0, x1 + 1):
            yield x, y0
            yield x, y1
        for y in range(y0 + 1, y1):
            yield x0, y
            yield x1, y

    def draw_label(p, x0, y0, x1, style):
        label = f" {p['index']} {p['command']} "
        room = x1 - x0 - 3
        if room >= 3:
            canvas.text(x0 + 2, y0, label, style, limit=room)

    # tiled panes share borders, so merge their edges into proper junctions
    tiled = [p for p in panes if not p["floating"]]
    edges = {}

    def add(x, y, bit):
        edges[(x, y)] = edges.get((x, y), 0) | bit

    for p in tiled:
        x0, y0, x1, y1 = box(p)
        for x in range(x0, x1):
            for y in (y0, y1):
                add(x, y, R)
                add(x + 1, y, L)
        for y in range(y0, y1):
            for x in (x0, x1):
                add(x, y, D)
                add(x, y + 1, U)
    for (x, y), mask in edges.items():
        canvas.put(x, y, BOX.get(mask, " "), border)

    for p in tiled:
        x0, y0, x1, y1 = box(p)
        draw_contents(canvas, p, x0, y0, x1, y1)
    for p in tiled:
        if p["active"]:
            x0, y0, x1, y1 = box(p)
            for x, y in perimeter(x0, y0, x1, y1):
                if 0 <= y < canvas.h and 0 <= x < canvas.w:
                    canvas.cells[y][x] = (canvas.cells[y][x][0], active_border)
    for p in tiled:
        x0, y0, x1, _ = box(p)
        draw_label(p, x0, y0, x1, active_border if p["active"] else fg(t["subtext_0"]))

    # floating panes sit on top and own their whole box
    for p in (p for p in panes if p["floating"]):
        x0, y0, x1, y1 = box(p)
        style = active_border if p["active"] else border
        for y in range(y0, y1 + 1):
            for x in range(x0, x1 + 1):
                canvas.put(x, y, " ")
        draw_box(canvas, x0, y0, x1, y1, style)
        draw_contents(canvas, p, x0, y0, x1, y1)
        draw_label(p, x0, y0, x1, style)

    print(canvas.render())


# Per-launch state (pending cursor focus) lives in a file shared between fzf's
# reload/transform invocations of this script, since each one is a separate process.
def load_state():
    with open(os.environ["SESSION_PICKER_STATE"]) as f:
        return json.load(f)


def save_state(state):
    with open(os.environ["SESSION_PICKER_STATE"], "w") as f:
        json.dump(state, f)


@contextlib.contextmanager
def picker_state():
    fd, path = tempfile.mkstemp(prefix="session-picker-", suffix=".json")
    os.close(fd)
    os.environ["SESSION_PICKER_STATE"] = path
    save_state({})
    try:
        yield
    finally:
        os.unlink(path)


def fuzzy(query, text):
    """Positions of query in text — a substring if possible, else a subsequence — or None. Smart case."""
    hay, needle = (
        (text, query)
        if any(c.isupper() for c in query)
        else (text.lower(), query.lower())
    )
    start = hay.find(needle)
    if start >= 0:
        return set(range(start, start + len(needle)))
    positions, j = set(), 0
    for i, ch in enumerate(hay):
        if j < len(needle) and ch == needle[j]:
            positions.add(i)
            j += 1
    return positions if j == len(needle) else None


def highlight(text, positions, style, match_style):
    if not positions:
        return f"{style}{text}\x1b[0m"
    return "".join(
        f"{match_style if i in positions else style}{ch}\x1b[0m"
        for i, ch in enumerate(text)
    )


# Rows 1-10 get the keys 0-9
def quick_key(n, t):
    return f"{fg(t['sky'])}{n - 1}\x1b[0m" if n <= 10 else " "


def digit(d, kind):
    """fzf actions for a digit key: type it while searching, else pick the row numbered with it."""
    if os.environ.get("FZF_INPUT_STATE", "hidden") != "hidden":
        print(f"put({d})")
        return
    n = int(d) + 1
    if kind == "claude":
        # leaving search clears the query, so with the input hidden every row is listed
        index = n if n <= int(os.environ.get("FZF_TOTAL_COUNT", "0")) else None
    else:
        sessions = [i + 1 for i, row in enumerate(items()) if row[0] == row[1]]
        index = sessions[n - 1] if n <= len(sessions) else None
    if index:
        print(f"pos({index})+accept")


def digit_binds(kind):
    return [
        arg
        for d in "0123456789"
        for arg in ("--bind", f"{d}:transform('{SELF}' digit {d} {kind})")
    ]


def jk_binds():
    """j/k move like down/up, unless the search input is up and they're typed into the query."""
    return [
        arg
        for k, move in (("j", "down"), ("k", "up"))
        for arg in (
            "--bind",
            f'{k}:transform:[ "$FZF_INPUT_STATE" = hidden ] && echo {move} || echo "put({k})"',
        )
    ]


# dd kills the row under the cursor, vim style: the first d arms it and swaps the key legend for a
# prompt, and a second d on the same row within KILL_TIMEOUT confirms
KILL_TIMEOUT = 1.0


def kill_key(kind, target):
    if os.environ.get("FZF_INPUT_STATE", "hidden") != "hidden":
        print("put(d)")
        return
    if not target:
        return
    state = load_state()
    armed = state.pop("armed", None)
    if armed and armed["target"] == target and time.time() - armed["at"] < KILL_TIMEOUT:
        if kind == "claude":
            kill_claude(target)
            reload = f"reload('{SELF}' claude-list)"
        else:
            focus = kill_row(target)
            if focus:
                state["focus"] = focus
            reload = f"reload('{SELF}' list {{q}})"
        save_state(state)
        redraw_legend()
        print(reload)
        return

    token = str(time.time_ns())
    what = describe_claude(target) if kind == "claude" else describe_row(target)
    state["armed"] = dict(target=target, at=time.time(), token=token, what=what)
    save_state(state)
    redraw_legend()
    print(f"bg-transform('{SELF}' disarm {token})")


def disarm(token):
    time.sleep(KILL_TIMEOUT)
    try:
        state = load_state()
    except (OSError, ValueError):
        # the picker already exited
        return
    # a later d re-armed or confirmed, and owns the legend now
    if state.get("armed", {}).get("token") != token:
        return
    del state["armed"]
    save_state(state)
    redraw_legend()


def kill_scope(target):
    """The session or window a kill on row <target> takes down: a session's only window is the session."""
    if target.startswith("$"):
        return target
    sid, count = (
        tmux("display", "-p", "-t", target, "#{session_id}\t#{session_windows}")
        .strip()
        .split("\t")
    )
    return target if count != "1" else sid


def describe_row(target):
    target = kill_scope(target)
    fmt = (
        "session #{session_name}"
        if target.startswith("$")
        else "window #{window_index} #{window_name}"
    )
    return tmux("display", "-p", "-t", target, fmt).strip()


def kill_row(target):
    """Kill row <target>'s session or window, returning the row to land on afterwards."""
    target = kill_scope(target)
    rows_ = items()
    doomed = {row[0] for row in rows_ if target in (row[0], row[1])}
    ids = [row[0] for row in rows_]
    i = ids.index(target) if target in ids else 0
    focus = next(
        (r for r in [*reversed(ids[:i]), *ids[i + 1 :]] if r not in doomed), None
    )
    if target.startswith("$"):
        kill_session(target)
    else:
        tmux("kill-window", "-t", target)
    return focus


def kill_session(sid):
    client = os.environ.get("SESSION_PICKER_CLIENT", "")
    # killing the client's own session would detach it, so move it off first
    if client and client_session(client) == sid:
        fallback = fallback_session(sid, client)
        if fallback:
            tmux("switch-client", "-c", client, "-t", fallback)
    tmux("kill-session", "-t", sid)


def fallback_session(sid, client):
    """The client's previous session, else the one before <sid> in the list, else the one after."""
    sessions = sorted(
        (
            s
            for s in rows("list-sessions", "-F", "#{session_id}\t#{session_name}")
            if not s[1].startswith(POPUP_PREFIX)
        ),
        key=lambda s: int(s[0].lstrip("$")),
    )
    last = tmux("display", "-p", "-c", client, "#{client_last_session}").strip()
    if found := next((s for s, name in sessions if name == last and s != sid), None):
        return found
    ids = [s for s, _ in sessions]
    i = ids.index(sid) if sid in ids else 0
    others = [*reversed(ids[:i]), *ids[i + 1 :]]
    return others[0] if others else None


# Expansion is a session option rather than picker state, so it carries over between launches and
# goes away with the session.
EXPANDED_OPT = "@session_picker_expanded"


def is_expanded(sid):
    return tmux("show", "-qv", "-t", sid, EXPANDED_OPT).strip() == "1"


def set_expanded(sid, on):
    if on:
        tmux("set", "-t", sid, EXPANDED_OPT, "1")
    else:
        tmux("set", "-u", "-t", sid, EXPANDED_OPT)


# Last highlighted row (session or window id), so the next launch reopens where you left off
LAST_OPT = "@session_picker_last"

# the popup script's hidden sessions hold popups (this picker included), not work
POPUP_PREFIX = "_popup_"


def items(query=""):
    """Rows as (id, session_id, display, matched), sessions in creation (id) order.

    Without a query, windows are listed only under expanded sessions. With one, the script filters
    instead of fzf so a matching window always brings its session row along.
    """
    t = theme()
    sessions = rows(
        "list-sessions",
        "-F",
        "#{session_id}\t#{session_name}\t#{session_windows}\t#{session_attached}"
        f"\t#{{{EXPANDED_OPT}}}",
    )
    windows = rows(
        "list-windows",
        "-a",
        "-F",
        "#{session_id}\t#{window_id}\t#{window_index}\t#{window_name}\t#{window_panes}",
    )

    reset = "\x1b[0m"
    match_style = fg(t["peach"], bold=True)
    out = []
    sessions = [s for s in sessions if not s[1].startswith(POPUP_PREFIX)]
    for n, (sid, name, count, attached, expanded) in enumerate(
        sorted(sessions, key=lambda s: int(s[0].lstrip("$"))), 1
    ):
        own = [w for w in windows if w[0] == sid]
        if query:
            s_pos = fuzzy(query, name)
            shown = [(w, p) for w in own if (p := fuzzy(query, w[3])) is not None]
            if s_pos is None and not shown:
                continue
        else:
            s_pos = set()
            shown = [(w, set()) for w in own] if expanded == "1" else []

        arrow = f"{fg(t['overlay_1'])}{'▾' if shown else '▸'}{reset}"
        dot = f" {fg(t['green'])}●{reset}" if attached != "0" else ""
        label = highlight(name, s_pos, fg(t["blue"], bold=True), match_style)
        count_label = f"{count} window{'' if count == '1' else 's'}"
        out.append(
            (
                sid,
                sid,
                f"{quick_key(n, t)} {arrow} {label} {fg(t['overlay_0'])}{count_label}{reset}{dot}",
                bool(query) and s_pos is not None,
            )
        )
        for (_, wid, idx, wname, panes), w_pos in shown:
            extra = f" {fg(t['overlay_0'])}{panes} panes{reset}" if panes != "1" else ""
            label = highlight(wname, w_pos, fg(t["text"]), match_style)
            out.append(
                (
                    wid,
                    sid,
                    f"      {fg(t['overlay_1'])}{idx}{reset} {label}{extra}",
                    bool(query),
                )
            )
    return out


def print_list(query):
    for row_id, _, display, _ in items(query):
        print(f"{row_id}\t{display}")


def key(action, target, query):
    """Print fzf actions for a key press or event (consumed by fzf's transform)."""
    state = load_state()
    reload = f"reload('{SELF}' list {{q}})"
    searching = os.environ.get("FZF_INPUT_STATE", "hidden") != "hidden"

    if action in ("h", "l"):
        if searching:
            print(f"put({action})")
            return
        action = "left" if action == "h" else "right"

    # Cursor placement after a reload happens here rather than via fzf's track-current: tracking
    # blocks the UI until it resolves, which swallows the hide-input chained after esc.
    if action == "result":
        rows_ = items(query)
        focus = state.get("focus")
        if focus:
            index = next((i for i, row in enumerate(rows_) if row[0] == focus), None)
            # a query change fires result against the old list before the reload lands, so the focus
            # is kept until fzf holds this list and the cursor is really on it
            landed = target == focus and os.environ.get("FZF_TOTAL_COUNT") == str(
                len(rows_)
            )
            if index is None or landed:
                del state["focus"]
                save_state(state)
                return
        elif query:
            # land on the first match so Enter goes straight to it
            index = next((i for i, row in enumerate(rows_) if row[3]), None)
        else:
            return
        if index is not None:
            print(f"pos({index + 1})")
        return

    if action == "esc":
        if not searching:
            print("abort")
            return
        # leaving search on a window: open its session so the window stays visible in the tree
        if target.startswith("@"):
            set_expanded(
                tmux("display", "-p", "-t", target, "#{session_id}").strip(), True
            )
        state["focus"] = target
        save_state(state)
        # clear-query doesn't fire the change event, so reload explicitly. hide-input is chained
        # after the transform in the binding: inside a transform it restores the cleared query.
        print(f"clear-query+reload('{SELF}' list)")
        return

    # while searching, left/right move the cursor in the query
    if searching or not target:
        print("forward-char" if action == "right" else "backward-char")
        return

    is_session = target.startswith("$")
    sid = (
        target
        if is_session
        else tmux("display", "-p", "-t", target, "#{session_id}").strip()
    )
    expanded = is_expanded(sid)

    if action == "right" and is_session:
        if expanded:
            print("down")
            return
        set_expanded(sid, True)
    elif action == "left" and expanded:
        set_expanded(sid, False)
    else:
        return

    # collapsing from a window lands on its session, since the window row goes away
    state["focus"] = sid
    save_state(state)
    print(reload)


def picker(client):
    current = client_session(client) if client else ""
    rows_ = items()

    # reopen on the last highlighted row; a window hidden under a since-collapsed session falls back
    # to that session, and anything gone falls back to the client's current session
    last = tmux("show", "-gqv", LAST_OPT).strip()
    candidates = [last]
    if last.startswith("@"):
        candidates.append(tmux("display", "-p", "-t", last, "#{session_id}").strip())
    candidates.append(current)
    ids = [row[0] for row in rows_]
    start = next((ids.index(c) + 1 for c in candidates if c and c in ids), 1)

    os.environ["SESSION_PICKER_CLIENT"] = client
    run = f"'{SELF}'"
    with picker_state(), legend("session"):
        result = subprocess.run(
            # --disabled: the script does the filtering (see items), fzf only displays
            [
                "fzf",
                "--ansi",
                "--delimiter",
                "\t",
                "--with-nth",
                "2",
                "--layout",
                "reverse",
                "--no-sort",
                "--disabled",
                "--no-input",
                "--highlight-line",
                "--info",
                "inline-right",
                "--prompt",
                "/ ",
                "--pointer",
                "▌",
                "--preview",
                f"{run} preview {{1}}",
                "--preview-window",
                "right,78%,border-left",
                "--bind",
                f"load:pos({start})+unbind(load)",
                # the preview is drawn to fit its area, so a resize needs a fresh one
                "--bind",
                "resize:refresh-preview",
                "--bind",
                f"focus:execute-silent(tmux set -g {LAST_OPT} {{1}})",
                "--bind",
                f"change:reload({run} list {{q}})",
                "--bind",
                f"result:transform({run} key result {{1}} {{q}})",
                "--bind",
                f"right:transform({run} key right {{1}} {{q}})",
                "--bind",
                f"left:transform({run} key left {{1}} {{q}})",
                "--bind",
                f"l:transform({run} key l {{1}} {{q}})",
                "--bind",
                f"h:transform({run} key h {{1}} {{q}})",
                *jk_binds(),
                "--bind",
                f"esc:transform({run} key esc {{1}} {{q}})+hide-input",
                # the query only takes keys once / reveals the input; until then q quits
                "--bind",
                '/:transform:[ "$FZF_INPUT_STATE" = hidden ] && echo show-input || echo "put(/)"',
                "--bind",
                'q:transform:[ "$FZF_INPUT_STATE" = hidden ] && echo abort || echo "put(q)"',
                "--bind",
                f"d:transform({run} kill session {{1}})",
                *digit_binds("session"),
            ],
            input="\n".join(f"{row_id}\t{display}" for row_id, _, display, _ in rows_),
            stdout=subprocess.PIPE,
            text=True,
        )

    if result.returncode == 0 and result.stdout:
        target = result.stdout.split("\t", 1)[0]
        args = ["switch-client", "-t", target] + (["-c", client] if client else [])
        tmux(*args)


def claude_items():
    """Rows for every pane running Claude Code, titled by directory (+ #n when shared)."""
    t = theme()
    reset = "\x1b[0m"
    seen_panes, panes = set(), []
    for p in rows(
        "list-panes",
        "-a",
        "-F",
        "#{session_id}\t#{window_index}\t#{pane_index}\t#{pane_id}"
        "\t#{pane_current_command}\t#{pane_current_path}\t#{pane_title}",
    ):
        # grouped sessions list the same pane once per session
        if p[4] == "claude" and p[3] not in seen_panes:
            seen_panes.add(p[3])
            panes.append(p)
    panes.sort(key=lambda p: (int(p[0].lstrip("$")), int(p[1]), int(p[2])))

    names = [os.path.basename(p[5].rstrip("/")) or "/" for p in panes]
    total = {n: names.count(n) for n in names}
    numbered = {}
    out = []
    for n, (p, name) in enumerate(zip(panes, names), 1):
        numbered[name] = numbered.get(name, 0) + 1
        label = f"{name} #{numbered[name]}" if total[name] > 1 else name
        title = f" {fg(t['overlay_0'])}{p[6]}{reset}" if p[6] else ""
        out.append(
            f"{p[3]}\t{quick_key(n, t)} {fg(t['blue'], bold=True)}{label}{reset}{title}"
        )
    return out


# Working in a Claude pane from the popup: a nested client attaches to a throwaway session grouped
# with the pane's session, so it can show the pane's window without moving the user's own client.
# That session's key-table makes C-c/C-d detach (C-d flagging the picker to quit too) and passes
# every other key to the pane. Quitting goes through the picker rather than closing the popup,
# which would kill it with SIGHUP and make the popup binding report a failure.
PEEK_TABLE = "claude-peek"


def peek(pane):
    sid, wid, zoomed = (
        tmux(
            "display",
            "-p",
            "-t",
            pane,
            "#{session_id}\t#{window_id}\t#{window_zoomed_flag}",
        )
        .rstrip("\n")
        .split("\t")
    )
    active = tmux("display", "-p", "-t", wid, "#{pane_id}").strip()
    name = f"claude-peek-{os.getpid()}"

    tmux("new-session", "-d", "-s", name, "-t", sid)
    for opt, value in (
        ("status", "off"),
        ("key-table", PEEK_TABLE),
        ("@claude_peek_restore", f"{wid} {active} {zoomed}"),
    ):
        # set/show take a pane target, where an exact session match needs the trailing colon
        tmux("set", "-t", f"={name}:", opt, value)
    tmux("bind", "-T", PEEK_TABLE, "C-c", "detach-client")
    # one string, so the ; separates commands inside the binding rather than ending the bind
    tmux("bind", "-T", PEEK_TABLE, "C-d", "set @claude_peek_quit 1 ; detach-client")

    # zoom is per window, so the pane's window is zoomed onto it here and restored in unpeek
    tmux("select-window", "-t", f"={name}:{wid}")
    if zoomed == "1":
        tmux("resize-pane", "-Z", "-t", active)
    tmux("select-pane", "-t", pane)
    tmux("resize-pane", "-Z", "-t", pane)

    # $TMUX has to go for tmux to allow the nested client, so pass its server socket explicitly
    socket = os.environ.get("TMUX", "").split(",")[0]
    env = {k: v for k, v in os.environ.items() if k != "TMUX"}
    try:
        # under fzf's execute, stdout is the pipe the picker reads fzf's result from, so hand the
        # client the terminal itself — by its real name, since tmux refuses the /dev/tty alias
        tty_name = subprocess.run(
            ["ps", "-o", "tty=", "-p", str(os.getpid())], capture_output=True, text=True
        ).stdout.strip()
        with open(f"/dev/{tty_name}", "r+b", buffering=0) as tty:
            subprocess.run(
                ["tmux", *(["-S", socket] if socket else []), "attach", "-t", f"={name}"],
                env=env,
                stdin=tty,
                stdout=tty,
                stderr=tty,
            )
    finally:
        if tmux("show", "-qv", "-t", f"={name}:", "@claude_peek_quit").strip() == "1":
            open(os.environ["CLAUDE_PICKER_QUIT"], "w").close()
        unpeek(name)


def after_peek():
    """fzf actions once a peek ends: leave if it ended with C-d, else refresh the list."""
    flag = os.environ["CLAUDE_PICKER_QUIT"]
    if os.path.exists(flag):
        os.unlink(flag)
        print("abort")
    else:
        print(f"reload('{SELF}' claude-list)+refresh-preview")


def unpeek(name):
    """Put the pane's window back as it was and drop the peek session (idempotent)."""
    restore = tmux("show", "-qv", "-t", f"={name}:", "@claude_peek_restore").split()
    if restore:
        wid, active, zoomed = restore
        if tmux("display", "-p", "-t", wid, "#{window_zoomed_flag}").strip() == "1":
            tmux("resize-pane", "-Z", "-t", wid)
        tmux("select-pane", "-t", active)
        if zoomed == "1":
            tmux("resize-pane", "-Z", "-t", active)
    tmux("kill-session", "-t", f"={name}")


def describe_claude(pane):
    path = tmux("display", "-p", "-t", pane, "#{pane_current_path}").strip()
    return f"claude in {os.path.basename(path.rstrip('/')) or '/'}"


def claude_pid(pane):
    """The claude process in <pane>, preferring the one in the terminal's foreground."""
    tty = tmux("display", "-p", "-t", pane, "#{pane_tty}").strip()
    if not tty:
        return None
    out = subprocess.run(
        ["ps", "-t", tty.removeprefix("/dev/"), "-o", "pid=,tpgid=,comm="],
        capture_output=True,
        text=True,
    ).stdout
    found = []
    for line in out.splitlines():
        pid, tpgid, comm = line.split(None, 2)
        if os.path.basename(comm.strip()) == "claude":
            found.append((pid != tpgid, int(pid)))
    return min(found)[1] if found else None


def kill_claude(pane):
    """SIGTERM lets Claude Code shut down cleanly; SIGKILL only if it outlasts the grace period.

    Waits for the exit either way, since the list reloads right after and would still show it.
    """
    pid = claude_pid(pane)
    if not pid:
        return
    with contextlib.suppress(ProcessLookupError):
        os.kill(pid, signal.SIGTERM)
        deadline = time.monotonic() + 3
        while time.monotonic() < deadline:
            time.sleep(0.05)
            os.kill(pid, 0)
        os.kill(pid, signal.SIGKILL)


def claude_picker(client):
    run = f"'{SELF}'"
    hidden = '[ "$FZF_INPUT_STATE" = hidden ]'
    # peek (under fzf's execute) creates this when a peek ends with C-d; after_peek consumes it
    quit_flag = os.path.join(tempfile.gettempdir(), f"claude-picker-quit-{os.getpid()}")
    os.environ["CLAUDE_PICKER_QUIT"] = quit_flag
    with picker_state(), legend("claude"):
        result = subprocess.run(
            [
                "fzf",
                "--ansi",
                "--delimiter",
                "\t",
                "--with-nth",
                "2",
                "--layout",
                "reverse",
                "--no-sort",
                "--no-input",
                "--highlight-line",
                "--info",
                "inline-right",
                "--prompt",
                "/ ",
                "--pointer",
                "▌",
                "--preview",
                f"{run} preview {{1}}",
                "--preview-window",
                "right,70%,border-left",
                # agents keep working while the list is up
                "--bind",
                "every(1):refresh-preview",
                "--bind",
                "resize:refresh-preview",
                "--bind",
                f'/:transform:{hidden} && echo show-input || echo "put(/)"',
                "--bind",
                f'q:transform:{hidden} && echo abort || echo "put(q)"',
                # hide-input sits outside the transform: inside one it restores the cleared query
                "--bind",
                f"esc:transform({hidden} && echo abort || echo clear-query)+hide-input",
                "--bind",
                f"i:transform:{hidden}"
                f' && echo "execute({run} peek {{1}})+transform({run} after-peek)"'
                ' || echo "put(i)"',
                "--bind",
                f"d:transform({run} kill claude {{1}})",
                *jk_binds(),
                *digit_binds("claude"),
            ],
            input="\n".join(claude_items()),
            stdout=subprocess.PIPE,
            text=True,
        )
    if os.path.exists(quit_flag):
        os.unlink(quit_flag)
    if result.returncode == 0 and result.stdout:
        pane = result.stdout.split("\t", 1)[0]
        tmux("select-window", "-t", pane)
        tmux("select-pane", "-t", pane)
        tmux("switch-client", "-t", pane, *(["-c", client] if client else []))


def popup(kind, client):
    try:
        size = max(0, min(100, int(os.environ.get("TMUX_SWITCHER_SIZE") or 0)))
    except ValueError:
        size = 0
    if size:
        frame = ["-w", f"{size}%", "-h", f"{size}%", "-b", "rounded", "-T", f" {kind} "]
    else:
        frame = ["-w", "100%", "-h", "100%", "-B"]
    args = [SELF, client] if kind == "sessions" else [SELF, "claude", client]
    # the popup script reopens the popup at the new size when the terminal resizes
    popup_script = os.path.join(os.path.dirname(SELF), "popup")
    home = os.path.expanduser("~")
    os.execv(popup_script, [popup_script, "open", client, kind, home, *frame, "--", *args])


